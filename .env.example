# USHSS Portal — Environment (.env)
# Supabase SQL version

# App
SECRET_KEY=your-secret-key-here-minimum-32-characters
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=your-db-password-here

# Email notifications and automated campaigns (configure in Vercel for production).
# Gmail: smtp.gmail.com:587 with a Google App Password. University SMTP values
# must be obtained from the university mail administrator.
# Campaign/test deliveries fail visibly when SMTP_HOST is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=USHSS Portal <no-reply@ushss.local>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_REPLY_TO=
EMAIL_CRON_SECRET=

USE_SQLITE_FALLBACK=0
